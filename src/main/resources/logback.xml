<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- 1. debug-log.txt 파일로 출력하는 Appender 정의 -->
  <appender name="DEBUG_FILE"
            class="ch.qos.logback.core.rolling.RollingFileAppender">
    <!-- 실제 저장될 파일 경로 -->
    <file>logs/debug-log.txt</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!-- 날짜별로 백업 파일 생성 -->
      <fileNamePattern>logs/debug-log.%d{yyyy-MM-dd}.txt</fileNamePattern>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
      <!-- 로그 출력 형식 -->
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} -
        %msg%n
      </pattern>
    </encoder>
  </appender>

  <!-- 2. AuthCon 클래스 전용 로거 설정 -->
  <!-- name에는 반드시 클래스의 풀패키지명(Full Qualified Name)을 적습니다 -->
  <logger name="com.bumsoap.store.controller.AuthCon" level="DEBUG"
          additivity="false">
    <!-- 위에서 만든 Appender와 연결 -->
    <appender-ref ref="DEBUG_FILE"/>
  </logger>

  <!-- 3. 나머지 전체(루트) 로그 설정 (예: 콘솔 출력) -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/> <!-- 콘솔 Appender가 있다고 가정 -->
  </root>

</configuration>